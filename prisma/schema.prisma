datasource db {
  provider = "mysql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

model User {
  id                  Int                  @id() @default(autoincrement())
  name                String               @db.VarChar(80)
  email               String               @unique() @db.VarChar(80)
  createdAt           DateTime?            @default(now())
  updatedAt           DateTime?
  forms               Form[]
  sessions            Session[]
  authMethods         AuthMethod[]
  submissions         FormSubmission[]
  passwordResetTokens PasswordResetToken[]
  accountSettings     AccountSettings?
  twoFactorAuth       TwoFactorAuth?
  verificationCodes   VerificationCode[]

  @@map("users")
}

model PasswordResetToken {
  id         Int       @id() @default(autoincrement())
  user_id    Int
  token_hash String    @unique() @db.VarChar(64)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime? @default(now())
  user       User      @relation(fields: [user_id], references: [id])

  @@map("password_reset_tokens")
}

model Session {
  id                       Int       @id() @default(autoincrement())
  user_id                  Int
  refresh_token_hash       String    @unique() @db.VarChar(255)
  user_agent               String?
  ip_address               String?
  is_valid                 Boolean   @default(true)
  remember_me              Boolean   @default(false)
  created_at               DateTime? @default(now())
  updated_at               DateTime?
  refresh_token_expires_at DateTime
  absolutely_expires_at    DateTime
  rotation_counter         Int       @default(0)
  revocation_reason        String?
  user                     User      @relation(fields: [user_id], references: [id])

  @@map("sessions")
}

model AuthMethod {
  id            Int     @id() @default(autoincrement())
  user_id       Int
  type          String  @db.VarChar(50)
  password_hash String? @db.VarChar(255)
  provider      String? @db.VarChar(50)
  provider_id   String? @db.VarChar(255)
  user          User    @relation(fields: [user_id], references: [id])

  @@unique([provider, provider_id])
  @@map("auth_methods")
}

model AccountSettings {
  id                         Int       @id() @default(autoincrement())
  user_id                    Int       @unique()
  recovery_email             String?   @db.VarChar(80)
  recovery_email_verified_at DateTime?
  recovery_email_pending     String?   @db.VarChar(80)
  created_at                 DateTime? @default(now())
  updated_at                 DateTime?
  user                       User      @relation(fields: [user_id], references: [id])

  @@map("account_settings")
}

model TwoFactorAuth {
  id           Int                   @id() @default(autoincrement())
  user_id      Int                   @unique()
  secret       String                @db.VarChar(255)
  is_enabled   Boolean               @default(false)
  confirmed_at DateTime?
  created_at   DateTime?             @default(now())
  updated_at   DateTime?
  user         User                  @relation(fields: [user_id], references: [id])
  backupCodes  TwoFactorBackupCode[]

  @@map("two_factor_auth")
}

model TwoFactorBackupCode {
  id            Int           @id() @default(autoincrement())
  two_factor_id Int
  code_hash     String        @db.VarChar(255)
  used_at       DateTime?
  created_at    DateTime?     @default(now())
  twoFactorAuth TwoFactorAuth @relation(fields: [two_factor_id], references: [id])

  @@map("two_factor_backup_codes")
}

model VerificationCode {
  id         Int       @id() @default(autoincrement())
  user_id    Int
  purpose    String    @db.VarChar(30)
  code_hash  String    @db.VarChar(64)
  attempts   Int       @default(0)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime? @default(now())
  user       User      @relation(fields: [user_id], references: [id])

  @@map("verification_codes")
}

model Form {
  id             Int              @id() @default(autoincrement())
  user_id        Int
  title          String           @db.VarChar(100)
  description    String           @db.LongText
  published      Boolean          @default(false)
  is_favorite    Boolean          @default(false)
  created_at     DateTime?        @default(now())
  updated_at     DateTime?
  last_opened_at DateTime?
  user           User             @relation(fields: [user_id], references: [id])
  sections       FormSection[]
  fields         FormField[]
  submissions    FormSubmission[]
  publication    FormPublication?
  config         FormConfig?

  @@map("forms")
}

model FormPublication {
  id           Int      @id @default(autoincrement())
  form_id      Int      @unique
  hash         String   @unique @db.VarChar(64)
  published_at DateTime @default(now())
  is_active    Boolean  @default(true)
  form         Form     @relation(fields: [form_id], references: [id])

  @@map("form_publications")
}

model FormConfig {
  id                       Int       @id @default(autoincrement())
  form_id                  Int       @unique
  starts_at                DateTime?
  expires_at               DateTime?
  max_responses            Int?
  allow_anonymous          Boolean   @default(false)
  single_response_per_user Boolean   @default(false)
  allow_edit_response      Boolean   @default(false)
  form                     Form      @relation(fields: [form_id], references: [id], onDelete: Cascade)

  @@map("form_configs")
}

model FormSection {
  id          Int         @id @default(autoincrement())
  form_id     Int
  title       String?     @db.VarChar(150)
  description String?     @db.Text
  order       Int
  created_at  DateTime?   @default(now())
  updated_at  DateTime?
  form        Form        @relation(fields: [form_id], references: [id])
  fields      FormField[]
  image       Image?

  @@map("form_sections")
}

model Image {
  id         Int          @id @default(autoincrement())
  field_id   Int?         @unique
  section_id Int?         @unique
  key        String       @unique @db.VarChar(512)
  mime_type  String       @db.VarChar(100)
  size       Int
  created_at DateTime?    @default(now())
  updated_at DateTime?
  field      FormField?   @relation(fields: [field_id], references: [id])
  section    FormSection? @relation(fields: [section_id], references: [id])

  @@map("images")
}

model FieldCategory {
  id          Int         @id @default(autoincrement())
  name        String      @unique() @db.VarChar(80)
  description String?     @db.Text
  created_at  DateTime?   @default(now())
  updated_at  DateTime?
  fields      FormField[]
  fieldTypes  FieldType[]

  @@map("field_categories")
}

model FieldType {
  id          Int           @id @default(autoincrement())
  category_id Int
  name        String        @unique()
  created_at  DateTime?     @default(now())
  updated_at  DateTime?
  category    FieldCategory @relation(fields: [category_id], references: [id])
  formFields  FormField[]

  @@map("field_types")
}

model FormField {
  id          Int       @id @default(autoincrement())
  form_id     Int?
  section_id  Int?
  category_id Int
  type_id     Int
  label       String    @db.VarChar(150)
  required    Boolean   @default(false)
  order       Int
  created_at  DateTime? @default(now())
  updated_at  DateTime?

  form     Form?                  @relation(fields: [form_id], references: [id])
  section  FormSection?           @relation(fields: [section_id], references: [id])
  category FieldCategory          @relation(fields: [category_id], references: [id])
  type     FieldType              @relation(fields: [type_id], references: [id])
  options  FormFieldOption[]
  answers  FormSubmissionAnswer[]
  image    Image?

  @@map("form_fields")
}

model FormSubmission {
  id            Int                    @id @default(autoincrement())
  form_id       Int
  respondent_id Int?
  submitted_at  DateTime               @default(now())
  form          Form                   @relation(fields: [form_id], references: [id])
  respondent    User?                  @relation(fields: [respondent_id], references: [id])
  answers       FormSubmissionAnswer[]

  @@map("form_submissions")
}

model FormSubmissionAnswer {
  id            Int                          @id @default(autoincrement())
  submission_id Int
  field_id      Int
  value         String?                      @db.Text
  submission    FormSubmission               @relation(fields: [submission_id], references: [id])
  field         FormField                    @relation(fields: [field_id], references: [id])
  options       FormSubmissionAnswerOption[]

  @@unique([submission_id, field_id])
  @@map("form_submission_answers")
}

model FormSubmissionAnswerOption {
  id        Int                  @id @default(autoincrement())
  answer_id Int
  option_id Int
  answer    FormSubmissionAnswer @relation(fields: [answer_id], references: [id])
  option    FormFieldOption      @relation(fields: [option_id], references: [id])

  @@unique([answer_id, option_id])
  @@map("form_submission_answer_options")
}

model FormFieldOption {
  id            Int                          @id @default(autoincrement())
  field_id      Int
  label         String                       @db.VarChar(150)
  value         String                       @db.VarChar(150)
  created_at    DateTime?                    @default(now())
  updated_at    DateTime?
  field         FormField                    @relation(fields: [field_id], references: [id])
  answerOptions FormSubmissionAnswerOption[]

  @@map("form_field_options")
}
