datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "./client"
}

model User {
  id        Int      @id() @default(autoincrement())
  name      String   @db.VarChar(80)
  email     String   @unique() @db.VarChar(80)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime
  @@map("users")
}
