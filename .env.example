NODE_ENV="development"

PORT=3001

APP_NAME="Form System"

# When running via `docker compose`, DATABASE_HOST is overridden to the "db"
# service automatically — keep "localhost" here for running the API outside
# Docker (e.g. `npm run start:dev`) against `docker compose up db`.
DATABASE_HOST="localhost"

DATABASE_PORT=3306

DATABASE_USER="root"

DATABASE_PASSWORD="admin"

DATABASE_NAME="form-system-db"

DATABASE_URL="mysql://root:admin@localhost:3306/form-system-db"

JWT_SECRET="replace-with-a-random-secret"

JWT_REFRESH_SECRET="replace-with-a-different-random-secret"

JWT_EXPIRES_IN="15min"

JWT_REFRESH_EXPIRES_IN="30d"

GOOGLE_CLIENT_ID=""

GOOGLE_CLIENT_SECRET=""

GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

GITHUB_CLIENT_ID=""

GITHUB_CLIENT_SECRET=""

GITHUB_CALLBACK_URL="http://localhost:3001/auth/github/callback"

CORS_ORIGINS="http://localhost:5173"

CLIENT_URL="http://localhost:3000"

# Required at boot (MailService throws if either is missing) — get a free key at resend.com
RESEND_API_KEY=""

MAIL_FROM="Acme <onboarding@resend.dev>"
