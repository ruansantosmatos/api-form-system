# Never send secrets or local env into the build context/image
.env
.env.*
!.env.example

# Build artifacts — always produced fresh inside the image
dist
build
coverage
# Prisma client is regenerated inside the image; a stale host copy here would
# otherwise get COPYed on top of the freshly generated one.
src/generated

# Dependencies — installed fresh inside the image
node_modules

# VCS / editor / OS noise
.git
.gitignore
.vscode
.idea
.DS_Store

# Docker-related files themselves
Dockerfile
.dockerignore
docker-compose*.yml

# Docs, tests, logs — irrelevant to the runtime image
*.md
test
*.log
npm-debug.log*
